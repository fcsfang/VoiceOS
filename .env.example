# Runtime settings only; copy to .env and fill locally. Never commit .env.
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_API_KEY="REPLACE_LOCALLY"
# 应用导入与命令行退路接受同一组别名的任一处：OPENAI_MODEL 或 VOICEOS_TEXT_MODEL，
# OPENAI_REVIEW_EFFORT 或 VOICEOS_REVIEW_EFFORT。
OPENAI_MODEL="gpt-6.2-sol"
OPENAI_REVIEW_EFFORT="high"
VOICEOS_PROBE_MODEL="gpt-6-luna"
