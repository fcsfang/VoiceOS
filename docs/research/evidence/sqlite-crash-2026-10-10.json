{
  "probe": "sqlite-crash-uniqueness-v1",
  "sqlite_version": "3.53.4",
  "journal_mode": "wal",
  "synchronous": "FULL",
  "checks": {
    "committed_row_survives_process_exit": true,
    "uncommitted_row_rolled_back": true,
    "duplicate_identity_rejected": true,
    "database_integrity_ok": true
  },
  "scope": "synthetic database only; no power-loss, sleep, cross-resource atomicity, or external-write test",
  "date": "2026-10-10"
}
